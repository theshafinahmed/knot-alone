{
  "name": "knot-alone",
  "version": "0.1.0",
  "description": "A 3D multiplayer phone-browser game where friends are tied together with ropes.",
  "author": "Shafin Ahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theshafinahmed/knot-alone.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && tsx server/index.ts",
    "start:local": "vite build && tsx server/index.ts --local",
    "build": "vite build",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "cloudflared": "^0.7.3",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
